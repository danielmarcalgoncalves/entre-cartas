# ====================================================================
# Environment Configuration — Between Letters (Entre Cartas)
# Copy this file to .env and replace placeholder values with real secrets.
# NEVER commit .env or real credentials to version control.
# ====================================================================

# --------------------------------------------------------------------
# 1. Application & Server URLs
# --------------------------------------------------------------------
PORT=3000
RESERVED_PORT=3000
# Public frontend/application URL (used in password recovery links, welcome emails, and OAuth callbacks)
APP_URL=http://localhost:3000
# Internal Authentication Service URL (in Docker: http://auth-service:3000 | Local dev: http://127.0.0.1:3001)
AUTH_SERVICE_URL=http://auth-service:3000

# --------------------------------------------------------------------
# 2. MariaDB / MySQL Database Connection
# --------------------------------------------------------------------
DB_HOST=mariadb
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mariadb_password_here
DB_NAME=filmes_db

# --------------------------------------------------------------------
# 3. JWT & Session Security
# --------------------------------------------------------------------
# REQUIRED: Cryptographically strong secret (at least 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=generate_a_cryptographically_strong_secret_at_least_32_characters_long
# Optional: Require 6-digit OTP email verification before first sign-in (true / false)
REQUIRE_EMAIL_VERIFICATION=false

# --------------------------------------------------------------------
# 4. Google OAuth 2.0 Configuration
# --------------------------------------------------------------------
# Configure in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized JavaScript Origins:
#   - http://localhost:3000
#   - https://your-production-domain.com
# Authorized Redirect URIs:
#   - http://localhost:3000/api/auth/google/callback
#   - https://your-production-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --------------------------------------------------------------------
# 5. Brevo Transactional Emails (Welcome, Password Recovery & Verification)
# --------------------------------------------------------------------
# Option A: Brevo Official Transactional HTTP API (v3)
BREVO_API_KEY=your_brevo_v3_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@domain.com
BREVO_SENDER_NAME="Between Letters"

# Option B: Brevo SMTP Relay (automatically used when BREVO_API_KEY is not set)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=your_brevo_smtp_login@smtp-brevo.com
MAIL_PASS=your_brevo_smtp_key_here
MAIL_FROM="Between Letters <your_verified_sender@domain.com>"

# --------------------------------------------------------------------
# 6. Audit Log Service & Redis Streams
# --------------------------------------------------------------------
LOG_SERVICE_URL=http://log-service:3000
REDIS_URL=redis://redis:6379

# --------------------------------------------------------------------
# 7. MinIO Object Storage (Profile Photos)
# --------------------------------------------------------------------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=perfil-fotos
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

# --------------------------------------------------------------------
# 8. Stripe — Pro Sender Club Subscriptions
# --------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PRICE_ID=price_your_stripe_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Legacy compatibility
TMDB_API_KEY=your_tmdb_api_key_here
